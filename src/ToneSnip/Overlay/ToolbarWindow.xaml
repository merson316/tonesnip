<interop:PopupWindow x:Class="ToneSnip.App.Overlay.ToolbarWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:interop="using:ToneSnip.App.Interop"
                     xmlns:controls="using:ToneSnip.App.Controls"
                     xmlns:annotate="using:ToneSnip.App.Annotate">
  <!-- PopupWindow turns the DWM border off (on a dark surface Windows draws it as a hard white outline), so this 1 px
       hairline is the bar's only outline. Radius 8 matches the DWM corners. -->
  <Border x:Name="Root" Background="{ThemeResource SurfaceBase}" BorderBrush="{ThemeResource Stroke}" BorderThickness="1"
          CornerRadius="{StaticResource CornerRadius}" Padding="0">
    <StackPanel>
      <!-- Row 1: 40 high including its 4 px padding, 32 px controls, 4 px gaps. The Grid stretches with the window, so
           the row stays centred once the tool row underneath widens it. A divider's 4 px margins plus the panel's 4 px
           spacing put 8 px on each side of it. -->
      <Grid Height="40" Padding="4">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Not a SelectorBar: its ScrollPresenter has no natural width, so the window's unbounded content measure
               comes out thousands of pixels wide. It also owns its own selection, which fights the host setting the
               mode back after a click. -->
          <controls:ModeGroup x:Name="Modes" VerticalAlignment="Center" AutomationProperties.AutomationId="Overlay_Modes"
                              AutomationProperties.Name="Capture mode"/>
          <Rectangle Style="{StaticResource ToolDivider}"/>
          <!-- The stopwatch glyph is part of the DelayPill template; code sets the label and foreground. -->
          <Button x:Name="DelayBtn" Style="{StaticResource DelayPill}" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="Overlay_DelayPill" AutomationProperties.Name="Delay"
                  ToolTipService.ToolTip="Delay" Click="OnDelayPicker"/>
          <Rectangle Style="{StaticResource ToolDivider}"/>
          <ToggleButton x:Name="BtnAnnotate" Style="{StaticResource ToolToggle}" AutomationProperties.Name="Annotate"
                        AutomationProperties.AutomationId="Overlay_AnnotateToggle"
                        ToolTipService.ToolTip="Annotate (A)" Click="OnAnnotate">
            <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphAnnotate}" FontSize="16"/>
          </ToggleButton>
          <Rectangle Style="{StaticResource ToolDivider}"/>
          <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Close"
                  AutomationProperties.AutomationId="Overlay_CloseButton"
                  ToolTipService.ToolTip="Close (Esc)" Click="OnClose">
            <!-- Cancel is the toolbar weight of the X; ChromeClose is the thinner title bar one. -->
            <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphCancel}" FontSize="16"/>
          </Button>
        </StackPanel>
      </Grid>
      <!-- The delay choices expand inside the bar: this window never activates and is sized to its content, so a
           drop-down's popup would be clipped away. -->
      <controls:DelayBand x:Name="DelayRow" Visibility="Collapsed" AutomationProperties.AutomationId="Overlay_DelayBand"
                          AutomationProperties.Name="Delay"/>
      <!-- The separator is a Rectangle rather than the Band style: AnnotateBar has its own picker band, and a
           Band-styled wrapper would inset that band's hairline twice. -->
      <StackPanel x:Name="ToolRow" Visibility="Collapsed">
        <Rectangle Height="1" Margin="4,0" Fill="{ThemeResource Stroke}"/>
        <Border>
          <annotate:AnnotateBar x:Name="Bar" HorizontalAlignment="Center"/>
        </Border>
      </StackPanel>
      <!-- The brushes the delay pill switches between, resolved by XAML so the window's forced dark theme picks them;
           a code-side resource lookup would read the app's theme instead. -->
      <Grid Visibility="Collapsed">
        <Border x:Name="TokPrimary" Background="{ThemeResource TextPrimary}"/>
        <Border x:Name="TokSecondary" Background="{ThemeResource TextSecondary}"/>
        <Border x:Name="TokLayer" Background="{ThemeResource SurfaceLayer}"/>
      </Grid>
    </StackPanel>
  </Border>
</interop:PopupWindow>
