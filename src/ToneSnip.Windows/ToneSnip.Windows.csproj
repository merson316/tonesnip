<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ToneSnip.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- Build-time only: generates the UI Automation COM interfaces named in NativeMethods.txt (Interop/UiaTree.cs),
         whose vtables are too long to write out by hand safely. Nothing of it ships. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
    <ProjectReference Include="../ToneSnip.Core/ToneSnip.Core.csproj" />
    <!-- The GPU tonemap's compute shaders, precompiled from Capture/Shaders/Tonemap.hlsl (ShaderBytecodeTests says
         how to rebuild them). Nothing is compiled at run time. -->
    <EmbeddedResource Include="Capture/Shaders/*.cso" LogicalName="ToneSnip.Windows.Capture.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WARP tests drive the tonemapper's internals (the frame a capture keeps, the readback bands) directly. -->
    <InternalsVisibleTo Include="ToneSnip.Windows.Tests" />
    <!-- The debug build's harness (src/ToneSnip/Harness) reaches what only it uses, such as ScreenCapture.Upload and the
         GDI calls that read a tray icon back, without making it public API of the assembly that ships. -->
    <InternalsVisibleTo Include="tonesnip-debug" Condition="'$(ToneSnipHarness)' == 'true'" />
  </ItemGroup>
</Project>
