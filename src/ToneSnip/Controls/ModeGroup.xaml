<UserControl x:Class="ToneSnip.App.Controls.ModeGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 4 × 32 with a 4 gap = 140. The indicator sits over the row rather than inside a button, so it can slide across
       the gaps between them. -->
  <Grid Width="140" Height="32">
    <!-- RadioButtons, not ToggleButtons, so a screen reader announces one single-select set rather than four
         independent toggles. No GroupName: grouping by the immediate parent keeps the toolbar's and the Recent
         flyout's groups apart.
         PositionInSet/SizeOfSet are set explicitly because this is a plain panel, not a RadioButtons control, and
         XYFocusKeyboardNavigation supplies arrow key movement between the buttons; XYFocus alone does not give a
         screen reader the set position.
         The arrow keys only work in the Recent flyout. The overlay toolbar is WS_EX_NOACTIVATE and never takes focus,
         so there they do nothing. DelayBand and AnnotateBar have the same two hosts. -->
    <StackPanel Orientation="Horizontal" Spacing="4" XYFocusKeyboardNavigation="Enabled">
      <!-- A checked mode button keeps the SurfaceLayer fill and TextPrimary glyph; the accent for the checked mode is
           the sliding indicator below. Scoped to this panel because lightweight styling is scope based and a Style
           cannot carry a resource dictionary. Theme/PickerToggle.xaml explains why there is no HighContrast entry.
           Disabled states are not overridden because no mode button is ever disabled. -->
      <StackPanel.Resources>
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
              <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SurfaceLayer"/>
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SurfaceLayer"/>
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SurfaceLayer"/>
              <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextPrimary"/>
              <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextPrimary"/>
              <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextPrimary"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
              <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SurfaceLayer"/>
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SurfaceLayer"/>
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SurfaceLayer"/>
              <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextPrimary"/>
              <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextPrimary"/>
              <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextPrimary"/>
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </StackPanel.Resources>
      <RadioButton x:Name="BRect" Style="{StaticResource ModeToggle}" AutomationProperties.Name="Rectangle"
                   AutomationProperties.AutomationId="Overlay_ModeRectangle"
                   AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="4"
                   ToolTipService.ToolTip="Rectangle" Click="OnClick">
        <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphModeRectangle}" FontSize="16"/>
      </RadioButton>
      <RadioButton x:Name="BWindow" Style="{StaticResource ModeToggle}" AutomationProperties.Name="Window"
                   AutomationProperties.AutomationId="Overlay_ModeWindow"
                   AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="4"
                   ToolTipService.ToolTip="Window" Click="OnClick">
        <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphModeWindow}" FontSize="16"/>
      </RadioButton>
      <RadioButton x:Name="BFull" Style="{StaticResource ModeToggle}" AutomationProperties.Name="Full screen"
                   AutomationProperties.AutomationId="Overlay_ModeFullScreen"
                   AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="4"
                   ToolTipService.ToolTip="Full screen" Click="OnClick">
        <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphModeFullScreen}" FontSize="16"/>
      </RadioButton>
      <RadioButton x:Name="BFree" Style="{StaticResource ModeToggle}" AutomationProperties.Name="Freeform"
                   AutomationProperties.AutomationId="Overlay_ModeFreeform"
                   AutomationProperties.PositionInSet="4" AutomationProperties.SizeOfSet="4"
                   ToolTipService.ToolTip="Freeform" Click="OnClick">
        <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphModeFreeform}" FontSize="16"/>
      </RadioButton>
    </StackPanel>
    <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource Accent}"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2" IsHitTestVisible="False">
      <Rectangle.RenderTransform>
        <TranslateTransform x:Name="Offset"/>
      </Rectangle.RenderTransform>
    </Rectangle>
  </Grid>
</UserControl>
