<Application x:Class="ToneSnip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Required by every WinUI control. -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
        <!-- Icon codepoints. Merged before Controls.xaml, whose templates read them: a dictionary sees only what was
             merged ahead of it. -->
        <ResourceDictionary Source="ms-appx:///Theme/Glyphs.xaml"/>
        <!-- The app's brushes and control styles. -->
        <ResourceDictionary Source="ms-appx:///Theme/Controls.xaml"/>
        <!-- BasedOn the SDK's DefaultToggleSwitchStyle, so it is merged at this level, where a StaticResource can see
             XamlControlsResources. -->
        <ResourceDictionary Source="ms-appx:///Theme/SettingsToggle.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
