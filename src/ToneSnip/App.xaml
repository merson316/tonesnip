<Application x:Class="ToneSnip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Empty at startup: the control styles, glyphs and the app's own dictionaries are merged when the first XAML window
       is made (App.Resources.cs, EnsureResources), so the idle tray app does not hold them. -->
