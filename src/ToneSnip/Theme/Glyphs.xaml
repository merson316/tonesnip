<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Every icon in the app as a Segoe Fluent Icons codepoint, one key per purpose; FontIcons reference these rather
       than codepoints. Keys with the same glyph but a different meaning stay separate (GlyphZebra, GlyphKnee).
       Merged before Theme/Controls.xaml in App.xaml, whose DelayPill template reads GlyphDelay. -->

