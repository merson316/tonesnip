<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tokens are per theme and chosen from each element's RequestedTheme, so always reference them with
       ThemeResource; a StaticResource would freeze the theme that loaded first.
       All three themes are listed because there is no "Default" entry to fall back on. The HighContrast entry is only
       reached while RequestedTheme is Default, which Theme/ThemeManager ensures in a contrast theme.

       AutomationId scheme for every window: "Window_Element" in PascalCase. Prefixes: Settings_, Editor_, Flyout_,
       Overlay_ (toolbar, mode group, delay band), Tools_ (the annotate bar in both hosts), Countdown_, TextEntry_,
       Toast_. The element half names what the control is (Settings_ThemeCombo, Editor_SaveButton) and reuses an
       existing x:Name. Controls in an item template share one id per action (Flyout_RowCopy) and carry the row title
       in AutomationProperties.Name. Items told apart by position take a 1-based ordinal suffix (Overlay_Delay3,
       Flyout_Row1; row containers are stamped by Tray/HistoryFlyout.StampRowIds). A UserControl has no automation peer,
       so an id on one needs a peer such as Controls/ControlGroupAutomationPeer. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Theme/Light.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Theme/Dark.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Theme/HighContrast.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="ControlHeight">32</x:Double>
  <CornerRadius x:Key="CornerRadius">8</CornerRadius>
  <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
  <!-- Segoe UI Variable optical sizes, as in the Gallery's type ramp: Small at 12, Text at 14, Display at 20 and up.
       One family name per resource; a comma-separated list is not a fallback here. -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text</FontFamily>
  <FontFamily x:Key="UiFontSmall">Segoe UI Variable Small</FontFamily>
  <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display</FontFamily>

  <!-- Icon font for every FontIcon; codepoints are keys in Theme/Glyphs.xaml. No size here: it depends on the host,
       and icons in a host's own slot (NavigationViewItem.Icon, SettingsCard.HeaderIcon) take the slot's size. -->
  <Style x:Key="Glyph" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
  </Style>

  <!-- The window root where Mica is unavailable (applied by Theme/Backdrop). A Style rather than a brush set from code,
       so the ThemeResource follows the root's RequestedTheme. -->
  <Style x:Key="SolidWindowRoot" TargetType="Grid">
    <Setter Property="Background" Value="{ThemeResource SurfaceBase}"/>
  </Style>

  <!-- The type ramp, on the Gallery's steps: Caption 12/16, Body 14/20, Body Strong 14/20 SemiBold, Subtitle 20/28
       SemiBold. LineHeight is explicit because the font's natural line height is about a pixel short. -->
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="Foreground" Value="{ThemeResource TextPrimary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmall}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="Foreground" Value="{ThemeResource TextSecondary}"/>
  </Style>
  <!-- Used as the page title. TrimSideBearings, as in the stock SubtitleTextBlockStyle, aligns it with the cards below. -->
  <Style x:Key="Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontDisplay}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="LineHeight" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings"/>
  </Style>
  <!-- A group heading above a run of settings cards. -->
  <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrong}">
    <Setter Property="Margin" Value="0,24,0,8"/>
  </Style>
  <!-- The 10 px label on the Recent flyout's HDR / SDR badges. CharacterSpacing is in 1/1000 em (4 % tracking).
       LineHeight 0 restores automatic line height over Caption's 16. Foreground is set where the tag is placed. -->
  <Style x:Key="Tag" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="LineHeight" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CharacterSpacing" Value="40"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== Buttons and toggles: stock templates, lightweight overrides =====
       Every style below is BasedOn an SDK style and sets metrics only; colours are lightweight-styling keys aliased
       per theme in Theme/Light.xaml and Theme/Dark.xaml. Theme/HighContrast.xaml leaves those keys out, so the SDK's
       contrast resources apply.
       WinUI styles cannot carry resources, so the application dictionary holds one palette per key family. Families
       that need a different palette get an element-scoped dictionary: Theme/DeleteAction.xaml, Theme/PickerToggle.xaml,
       and ModeGroup's StackPanel.Resources in Controls/ModeGroup.xaml.
       LayoutOption and HotkeyBox are the only custom templates; each explains why beside its style.
       FocusVisualMargin is 0 because the SDK's -3 would make focus rects touch in the tool row, whose buttons sit
       4 px apart. -->

  <!-- The accent button (the annotate bar's Done). BorderThickness 0 drops the SDK's accent elevation edge. -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualMargin" Value="0"/>
  </Style>
  <!-- A button with no fill until the pointer is over it (zoom readout, row actions, toast close). -->
  <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualMargin" Value="0"/>
  </Style>
  <!-- A link at the foot of a card (the Recent flyout's "Open folder"). Metrics only; the colours are the
       HyperlinkButton* keys in the theme files. No Foreground here, because the template's states drive it. -->
  <Style x:Key="FooterLink" TargetType="HyperlinkButton">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="6,0,6,0"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmall}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <!-- A labelled command in the editor's command bar, in a 36 px row. -->
  <Style x:Key="LabelButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="10,0,12,0"/>
  </Style>
  <!-- The Recent flyout's delete action. Its Error palette is Theme/DeleteAction.xaml, merged into the button's own
       Resources. BorderThickness 1 reserves the pressed ring's space so the glyph never moves. -->
  <Style x:Key="DeleteAction" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Stock inputs keep the stock Windows chrome; only the type face and a few metrics are set. MinWidth 0 because the
       settings window sizes each box itself. The annotation text box styles itself (Annotate/TextEntryWindow.xaml). -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <!-- The implicit TextBox style also reaches the NumberBox's inner TextBox. -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}"/>
  <Style TargetType="Slider">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Annotation toolbar: 32 px square tool toggles, accent-filled when active (ToggleButton* keys in the theme files).
       No FontFamily: icons are FontIcons with their own font, and text content such as the band cells' "A" wants the
       stock content font. -->
  <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0"/>
    <Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{ThemeResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualMargin" Value="0"/>
  </Style>
  <!-- ToolToggle's shape as a plain button. -->
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="16"/>
  </Style>
  <!-- A Rectangle rather than AppBarSeparator: neither bar is a CommandBar, and in a contrast theme Stroke maps to
       WindowText, the correct pairing for the Window-coloured bars (AppBarSeparator uses ButtonText). -->
  <Style x:Key="ToolDivider" TargetType="Rectangle">
    <Setter Property="Width" Value="1"/><Setter Property="Height" Value="20"/><Setter Property="Margin" Value="4,0"/>
    <Setter Property="Fill" Value="{ThemeResource Stroke}"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- A picker toggle (colour, width, size): when open, SurfaceLayer under a Stroke ring rather than the accent. The
       palette is Theme/PickerToggle.xaml, merged into each element's Resources. BorderThickness 1 reserves the ring's
       space so the glyph never moves. -->
  <Style x:Key="PickerToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <!-- A view toggle (Zebra): PickerToggle's chrome with a label; instances also merge Theme/PickerToggle.xaml. -->
  <Style x:Key="ViewToggle" TargetType="ToggleButton" BasedOn="{StaticResource PickerToggle}">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <!-- LabelButton's metrics as a tool toggle (the editor's Annotate). -->
  <Style x:Key="LabelToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="10,0,12,0"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <!-- A capture-mode toggle. Checked is a SurfaceLayer fill only; the accent indicator is drawn by Controls/ModeGroup,
       whose StackPanel.Resources hold this palette. No setters: the key names what these buttons are. -->
  <Style x:Key="ModeToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}"/>

  <!-- The delay control, shared by the overlay toolbar and the Recent flyout. The host sets the text ("No delay",
       "3 s") and sets Foreground to TextPrimary once a delay is chosen. The glyph and label inherit the presenter's
       Foreground so the stock hover and disabled states reach both. Left-aligned because the flyout header can make
       it wider than its content. -->
  <Style x:Key="DelayPill" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Padding" Value="8,0,10,0"/>
    <Setter Property="Foreground" Value="{ThemeResource TextSecondary}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmall}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphDelay}" FontSize="16" VerticalAlignment="Center"/>
            <!-- Binding rather than x:Bind: this resource-dictionary template has no x:DataType; Content is a string. -->
            <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- One of the four delay choices in a band: a tool toggle wide enough for its label. -->
  <Style x:Key="DelayChip" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <!-- A band under the tool row (delay chips, a picker): 40 h including its padding, under a 1 px separator inset 4. -->
  <Style x:Key="Band" TargetType="Border">
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{ThemeResource Stroke}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>

  <!-- ===== Settings window ===== -->

  <!-- The nav pane and page sit directly on Mica, without the stock content layer's border and rounded corner. The
       matching transparent brushes are in the theme files. -->
  <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
  <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>

  <!-- The Toolkit SettingsCard's lightweight-styling metrics; its brushes are in the theme files. -->
  <x:Double x:Key="SettingsCardMinHeight">68</x:Double>
  <Thickness x:Key="SettingsCardPadding">16,14,16,14</Thickness>

  <!-- No ExpanderMinHeight or ExpanderHeaderPadding: at app scope they would also reach the Expander inside every
       Toolkit SettingsExpander, which has its own padding. -->

  <!-- One Recent-flyout layout choice: a schematic preview (the item's ContentTemplate) above a radio glyph and label
       (the item's Content, a string). The Accent ring is a separate Rectangle, so checking never shifts layout.
       A custom template because the stock RadioButton has no checked fill or ring for the whole tile, and
       ItemsView or GridView would lose the radio semantics. It stays a real RadioButton in a RadioButtons group, so
       keyboard and UIA behaviour are the platform's, and every brush is a token that Theme/HighContrast.xaml maps. -->
  <Style x:Key="LayoutOption" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked"/>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Fill.Opacity" Value="1"/>
                    <Setter Target="Ring.Opacity" Value="1"/>
                    <Setter Target="GlyphRing.Stroke" Value="{ThemeResource Accent}"/>
                    <Setter Target="GlyphFill.Fill" Value="{ThemeResource Accent}"/>
                    <Setter Target="GlyphDot.Opacity" Value="1"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Indeterminate"/>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Fill" Background="{ThemeResource SurfaceLayer}" CornerRadius="{StaticResource SmallCornerRadius}" Opacity="0"/>
            <Border BorderBrush="{ThemeResource Stroke}" BorderThickness="1" CornerRadius="{StaticResource SmallCornerRadius}"/>
            <Rectangle x:Name="Ring" Stroke="{ThemeResource Accent}" StrokeThickness="2" RadiusX="4" RadiusY="4" Opacity="0"/>
            <StackPanel Margin="{TemplateBinding Padding}" Spacing="8">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                  <Ellipse x:Name="GlyphRing" Stroke="{ThemeResource TextSecondary}" StrokeThickness="1"/>
                  <Ellipse x:Name="GlyphFill" Margin="1" Fill="Transparent"/>
                  <Ellipse x:Name="GlyphDot" Width="5" Height="5" Fill="{ThemeResource AccentText}" Opacity="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Caption}"
                           TextWrapping="NoWrap" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One key of a recorded chord, built in code by Settings/HotkeyBox.cs. Brushes come from a Style so they resolve
       against the element's theme; a lookup in code would use the application theme. -->
  <Style x:Key="HotkeyChip" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SurfaceLayer}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="HotkeyChipText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
    <Setter Property="Foreground" Value="{ThemeResource TextPrimary}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- The hotkey recorder (Settings/HotkeyBox): a custom Control, because a TextBox would bring a caret, IME and
       context menu and fight the global hook for PrintScreen. The frame uses the stock TextBox resources so it
       matches the inputs around it, including in contrast themes.
       Recording shows a separate Accent line rather than the focused border: the focused border's thicker bottom
       edge would move the chips, and the box is focused well before it starts recording. -->
  <Style x:Key="HotkeyBox" TargetType="Control">
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <!-- Minimums, not a fixed size: long chords and larger text scaling need to grow the box. -->
          <Grid MinWidth="200" MinHeight="32" Background="Transparent">
            <Border Background="{ThemeResource TextControlBackground}" BorderBrush="{ThemeResource TextControlBorderBrush}"
                    BorderThickness="{ThemeResource TextControlBorderThemeThickness}" CornerRadius="{ThemeResource ControlCornerRadius}"/>
            <Border x:Name="RecordLine" Height="2" Margin="1,0,1,1" VerticalAlignment="Bottom" Opacity="0"
                    Background="{ThemeResource Accent}"/>
            <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="4" Margin="8,0" VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
