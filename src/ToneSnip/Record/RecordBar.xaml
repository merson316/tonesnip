<interop:PopupWindow x:Class="ToneSnip.App.Record.RecordBar"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:interop="using:ToneSnip.App.Interop">
  <!-- The bar under a recording: the countdown, then the time recorded, and pause, stop and discard. Drawn as the
       overlay's toolbar is (the 1 px hairline is its only outline), and left out of the capture, so it is never in the
       video even when it has to sit inside the area. -->
  <Border x:Name="Root" Background="{ThemeResource SurfaceBase}" BorderBrush="{ThemeResource Stroke}" BorderThickness="1"
          CornerRadius="{StaticResource CornerRadius}" Padding="0">
    <StackPanel>
      <Grid Height="40" Padding="4">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <!-- The dot is the Error colour, the nearest the palette has to a recording light; dimmed while paused. A
               contrast theme draws it in the text colour. -->
          <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,0,8,0" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{ThemeResource Error}" VerticalAlignment="Center"
                     AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock x:Name="Time" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" MinWidth="48"
                       AutomationProperties.AutomationId="Record_Time"/>
          </StackPanel>
          <Rectangle Style="{StaticResource ToolDivider}"/>
          <ToggleButton x:Name="BtnPause" Style="{StaticResource ToolToggle}" AutomationProperties.Name="Pause"
                        AutomationProperties.AutomationId="Record_PauseToggle" IsEnabled="False"
                        ToolTipService.ToolTip="Pause" Click="OnPause">
            <FontIcon x:Name="PauseGlyph" Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphRecordPause}" FontSize="16"/>
          </ToggleButton>
          <Button x:Name="BtnStop" Style="{StaticResource ToolButton}" AutomationProperties.Name="Stop and save"
                  AutomationProperties.AutomationId="Record_StopButton"
                  ToolTipService.ToolTip="Stop and save" Click="OnStop">
            <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphRecordStop}" FontSize="16"/>
          </Button>
          <Button x:Name="BtnDiscard" Style="{StaticResource ToolButton}" AutomationProperties.Name="Discard"
                  AutomationProperties.AutomationId="Record_DiscardButton"
                  ToolTipService.ToolTip="Discard the recording" Click="OnDiscard">
            <FontIcon Style="{StaticResource Glyph}" Glyph="{StaticResource GlyphDelete}" FontSize="16"/>
          </Button>
        </StackPanel>
      </Grid>
      <!-- Narrator hears the countdown, pauses and the stop through this polite live region. Zero-sized rather than
           collapsed, since a collapsed element is out of the UIA tree and raises nothing. -->
      <TextBlock x:Name="Announcer" Width="0" Height="0" AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.AutomationId="Record_Announcer"/>
    </StackPanel>
  </Border>
</interop:PopupWindow>
